APP_ENV: staging
PORT: "8080"
REQUEST_ID_HEADER: x-request-id

# Cookies / CSRF
COOKIE_NAME: aicasa_session
COOKIE_DOMAIN: ""
COOKIE_SAMESITE: lax
COOKIE_SECURE: "true"
SESSION_SECRET: "CHANGE_ME"
CSRF_SECRET: "CHANGE_ME"
CSRF_COOKIE_NAME: aicasa_csrf

# CORS
FRONTEND_ORIGINS: "https://staging.example.com"

# File center
STORAGE_PROVIDER: gcs
GCS_BUCKET_PRIVATE: "YOUR_PRIVATE_BUCKET"
SIGNED_URL_TTL_SECONDS: "900"
FILE_SCAN_ENABLED: "true"

# Observability
SENTRY_DSN: ""
LOG_LEVEL: "info"
